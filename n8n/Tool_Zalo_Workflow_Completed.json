    {
      "parameters": {
        "jsCode": "const webhookData = $('Webhook Cào Nhóm').first().json.body || {};\nlet groupInfo = null;\n\ntry {\n  const linkNode = $('Lấy Thông Tin Từ Link Nhóm');\n  if (linkNode && linkNode.length > 0 && linkNode.first().json.response) {\n    groupInfo = linkNode.first().json.response;\n  }\n} catch (e) {\n  groupInfo = null;\n}\n\nconst membersData = $input.first().json;\n\nif (!groupInfo) {\n  groupInfo = {\n    groupId: webhookData.groupId || membersData.groupId || 'GROUP_' + Date.now(),\n    name: 'Nhóm Zalo ' + (webhookData.groupId || ''),\n    desc: '',\n    creatorId: '',\n    adminIds: [],\n    totalMember: (membersData.memberIds || []).length\n  };\n}\n\nreturn [{\n  json: {\n    success: true,\n    response: groupInfo,\n    memberIds: membersData.memberIds || [],\n    profiles: membersData.profiles || {},\n    callbackUrl: webhookData.callbackUrl || 'http://localhost:3000/api/webhooks/zalo/import'\n  }\n}];"
      },
