        "jsCode": "function extractUids(obj, set) {\n  if (!obj) return;\n  if (typeof obj === 'string' || typeof obj === 'number') {\n    const s = String(obj).trim();\n    if (/^\\d{8,}$/.test(s)) set.add(s);\n    return;\n  }\n  if (Array.isArray(obj)) {\n    for (const item of obj) extractUids(item, set);\n    return;\n  }\n  if (typeof obj === 'object') {\n    const candidate = obj.userId || obj.id || obj.zaloId || obj.uid || obj.user_id || obj.fId;\n    if (candidate && /^\\d{8,}$/.test(String(candidate))) {\n      set.add(String(candidate));\n    }\n    for (const [k, v] of Object.entries(obj)) {\n      if (/^\\d{8,}$/.test(k)) {\n        set.add(k);\n      }\n      if (['data', 'response', 'items', 'friends', 'sentRequests', 'requests', 'list', 'dataList'].includes(k)) {\n        extractUids(v, set);\n      }\n    }\n  }\n}\n\nconst friendIdsSet = new Set();\ntry {\n  const items = $('Đồng Bộ - Lấy Danh Sách Bạn Bè').all();\n  for (const it of items) extractUids(it.json, friendIdsSet);\n} catch (e) {}\n\nconst pendingIdsSet = new Set();\ntry {\n  const items = $('Đồng Bộ - Lấy Lời Mời Đã Gửi').all();\n  for (const it of items) extractUids(it.json, pendingIdsSet);\n} catch (e) {}\n\nconst friendIds = Array.from(friendIdsSet);\nconst pendingIds = Array.from(pendingIdsSet);\n\nreturn [{\n  json: {\n    success: true,\n    totalFriends: friendIds.length,\n    totalPending: pendingIds.length,\n    friendIds: friendIds,\n    pendingIds: pendingIds,\n    timestamp: new Date().toISOString()\n  }\n}];"
