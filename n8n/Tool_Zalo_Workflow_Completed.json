      "parameters": {
        "jsCode": "const body = $input.first().json.body || {};\nconst template = body.message?.text || '';\nconst mediaType = body.message?.mediaType || (body.message?.videoUrl ? 'video' : (body.message?.imageUrl ? 'image' : (body.message?.documentUrl ? 'document' : 'none')));\nconst mediaUrl = body.message?.mediaUrl || body.message?.documentUrl || body.message?.imageUrl || body.message?.videoUrl || '';\nconst imageUrl = body.message?.imageUrl || (mediaType === 'image' ? mediaUrl : '');\nconst videoUrl = body.message?.videoUrl || (mediaType === 'video' ? mediaUrl : '');\nconst documentUrl = body.message?.documentUrl || (mediaType === 'document' ? mediaUrl : '');\nconst fileName = body.message?.fileName || '';\nconst ctaLink = body.message?.ctaLink || '';\nconst autoFriendFirst = Boolean(body.settings?.autoFriendFirst);\nconst delaySeconds = Number(body.settings?.delaySeconds || 15);\nconst recipients = body.recipients || [];\n\nreturn recipients.map((r, idx) => {\n  let personalized = template.replace(/\\{name\\}/g, r.name || 'bạn');\n  if (ctaLink) {\n    personalized += '\\n\\n👉 Xem thêm tại: ' + ctaLink;\n  }\n  return {\n    json: {\n      index: idx + 1,\n      total: recipients.length,\n      campaignId: body.campaignId,\n      campaignName: body.campaignName || '',\n      zaloId: String(r.zaloId),\n      name: r.name || 'Thành viên',\n      isFriend: Boolean(r.isFriend),\n      autoFriendFirst: autoFriendFirst,\n      delaySeconds: delaySeconds,\n      personalizedMessage: personalized,\n      mediaType: mediaType,\n      mediaUrl: mediaUrl,\n      imageUrl: imageUrl,\n      videoUrl: videoUrl,\n      documentUrl: documentUrl,\n      fileName: fileName\n    }\n  };\n});"
