    {
      "parameters": {
        "jsCode": "const webhookData = $('Webhook Cào Nhóm').first()?.json?.body || {};\nlet groupInfo = null;\n\ntry {\n  const linkItem = $('Lấy Thông Tin Từ Link Nhóm').first()?.json;\n  if (linkItem) {\n    const raw = linkItem.response || linkItem.data || linkItem;\n    if (raw && (raw.groupId || raw.grid || raw.name || raw.groupName)) {\n      const gId = String(raw.groupId || raw.grid || raw.id || webhookData.groupId || '');\n      const gName = String(raw.name || raw.groupName || raw.title || webhookData.name || webhookData.groupName || '');\n      const gAvatar = String(raw.avt || raw.fullAvt || raw.avatar || raw.groupAvatar || '');\n      const gDesc = String(raw.desc || raw.description || '');\n      const gCreator = String(raw.creatorId || raw.ownerId || raw.creator || '');\n      const gAdmins = Array.isArray(raw.adminIds) ? raw.adminIds : (Array.isArray(raw.admins) ? raw.admins : []);\n\n      groupInfo = {\n        groupId: gId,\n        name: gName || ('Nhóm Zalo ' + gId),\n        avatar: gAvatar,\n        avt: gAvatar,\n        fullAvt: gAvatar,\n        desc: gDesc,\n        creatorId: gCreator,\n        adminIds: gAdmins,\n        totalMember: Number(raw.totalMember || (raw.currentMems ? raw.currentMems.length : 0))\n      };\n    }\n  }\n} catch (e) {\n  groupInfo = null;\n}\n\nconst membersData = $input.first()?.json || {};\nlet memberIds = membersData.memberIds || [];\nconst profiles = membersData.profiles || {};\n\nif (!groupInfo) {\n  const fallbackId = String(webhookData.groupId || membersData.groupId || ('GROUP_' + Date.now()));\n  const fallbackName = String(webhookData.name || webhookData.groupName || ('Nhóm Zalo ' + fallbackId));\n  groupInfo = {\n    groupId: fallbackId,\n    name: fallbackName,\n    avatar: String(webhookData.avatar || ''),\n    avt: String(webhookData.avatar || ''),\n    desc: '',\n    creatorId: String(membersData.creatorId || ''),\n    adminIds: Array.isArray(membersData.adminIds) ? membersData.adminIds : [],\n    totalMember: memberIds.length\n  };\n} else {\n  if (!groupInfo.totalMember || groupInfo.totalMember === 0) {\n    groupInfo.totalMember = memberIds.length;\n  }\n  if (!groupInfo.groupId) {\n    groupInfo.groupId = String(webhookData.groupId || membersData.groupId || ('GROUP_' + Date.now()));\n  }\n}\n\ntry {\n  const linkItem = $('Lấy Thông Tin Từ Link Nhóm').first()?.json;\n  const currentMems = linkItem?.response?.currentMems || linkItem?.currentMems || [];\n  for (const m of currentMems) {\n    if (m && m.id) {\n      const mid = String(m.id);\n      if (!profiles[mid]) {\n        profiles[mid] = {\n          id: mid,\n          displayName: m.dName || m.zaloName || '',\n          zaloName: m.zaloName || '',\n          avatar: m.avatar || m.avatar_25 || '',\n          accountStatus: m.accountStatus || 0\n        };\n      }\n      if (!memberIds.includes(mid)) {\n        memberIds.push(mid);\n      }\n    }\n  }\n} catch (e) {}\n\nif (groupInfo) {\n  groupInfo.totalMember = memberIds.length;\n}\n\nreturn [{\n  json: {\n    success: true,\n    response: groupInfo,\n    memberIds: memberIds,\n    profiles: profiles\n  }\n}];"
      },
